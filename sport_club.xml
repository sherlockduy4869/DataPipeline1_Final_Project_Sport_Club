            <TEAMID>1</TEAMID>
            <!-- Reference to the FACILITY (by ID) where the session takes place -->
            <FACILITYID>1</FACILITYID>
            <!-- EQUIPMENTS: list of equipment items required for this session -->
            <EQUIPMENTS>
